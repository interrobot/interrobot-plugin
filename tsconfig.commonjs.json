{
    "compileOnSave": true,
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2019",
        "lib": ["ES2019", "DOM", "DOM.Iterable"],
        "declaration": true,
        "outDir": "./dist/js/commonjs",
        "rootDir": "./src/ts",
        "moduleResolution": "bundler"
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
